# ⚠️ COPY this file to .env and fill REAL values. .env is gitignored.
# Tùng PR #24 review 2026-05-18 — DO NOT commit .env to git.

# Firebase Configuration
# Get from: Firebase Console → Project Settings → General
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id_here
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Environment
ENV=development

# OriLife backend (Cloudflare Tunnel)
# Staging: https://api.orilife.io  (Tiger:7390)
# Prod:    https://api.orilife.io (Tiger:7380, owned by Thắng Lợi)
ALADIN_API_URL=https://api.orilife.io
ALADIN_API_KEY=mock-local-api-key
ALADIN_REGION_CODE=vn-south-01
PHOENIXKEY_API_URL=https://api.phoenixkey.me/api/v1
# Ví Phượng hoàng (ký tác-vụ did_payment). MẶC ĐỊNH false: backend Phase 2 CHƯA
# deploy → UI ẩn/disable nút ký. Đặt true SAU khi backend did_payment sẵn sàng
# VÀ đã đối-chiếu shape API ở src/services/phoenixWallet-api.ts. Bật cờ KHÔNG mở
# mainnet (mainnet chặn riêng ở ALLOWED_SIGN_NETWORKS).
PHOENIX_WALLET_ENABLED=false

# ── Chuỗi Cardano app nói chuyện — NGUỒN DUY NHẤT ────────────────────────────
# `1` hoặc `mainnet` = tiền THẬT. Mọi giá trị khác, kể cả để trống, = chuỗi thử
# (preprod). Rơi về chuỗi thử là fail-safe có chủ ý: đoán nhầm sang chuỗi thử
# thì người dùng thấy số dư 0 và kêu ngay; đoán nhầm sang mainnet thì app ký
# giao dịch bằng tiền thật của họ.
#
# Lên mainnet = đổi ĐÚNG dòng này (hoặc đặt biến cùng tên trên Codemagic).
# Không sửa mã. Con số này trước đây nằm cứng ở bảy tệp rời nhau; test
# `src/config/cardanoNetwork.test.ts` nay chặn không cho ai đặt lại số rời.
CARDANO_NETWORK=0

# Ví tổ chức: tạo OrgDID + mint LAMP bằng OrgDID. MẶC ĐỊNH false vì mint CHƯA
# chạy thật — cap/authority/redeemer còn chờ LAMP hợp nhất design lên main, và
# phần dựng+ký CBOR chạy ở Enclave native (Thư) chưa ráp. Bật true SAU khi:
# (1) LAMP chốt cap/authority; (2) native cấp buildAndSignTx; (3) đối-chiếu shape
# API thật ở src/services/orgMint-api.ts. Khi false → UI xem được nhưng nút thao
# tác disabled, service ném OrgMintDisabledError trước khi gọi mạng.
ORG_MINT_ENABLED=false

MESHAPI_USE_MOCK=false
LAMPNET_BASE_URL=https://lampnet.cloud
LAMPNET_UPLOAD_URL=https://lampnet.cloud/mirage/put?mode=symmetric
CAPTURES_3D_URL=https://api.orilife.io/captures/3d
# ⚠️ TẠM THỜI (giai đoạn test ReID quả/cây): trỏ về field-reid prototype api.orilife.io
#    vì các endpoint định-danh quả/cây (/api/fruit/*, /api/identify, /api/tree/*/layout...)
#    hiện CHỈ có trên prototype này. KHÔNG trỏ staging-api của Lợi — backend đó CHƯA có các route đó.
#    SAU KHI test xong sẽ HỢP-NHẤT về staging-api của Lợi (việc backend-unification PA3:
#    tạo cây 7390 trước → enroll field-reid cùng id → đẩy embedding ngược). Lúc đó đổi lại URL này.
ORILIFE_API_BASE_URL=https://api.orilife.io

# Tree Identity Native (TreeReID)
ORILIFE_TREEID_URL=https://api.orilife.io/TreeIdentity
ORILIFE_TREEID_BASE_URL=https://api.orilife.io


# ProofChat (trò chuyện E2EE 3 tầng — MLS + message + Merkle). Nguồn cấu hình DUY NHẤT:
# ProofChat/INTEGRATION.md (bản 2026-08-08 — đọc mục ⚠️ đầu tài liệu: bản 2026-07-04 dạy SAI
# 4 chỗ). Bản cũ `_team-messages/ProofChat-integration-answer.md` thuộc kênh thư đã ngừng
# (nay là `_Agents/inbox/`) và KHÔNG nằm trong repo — đừng tra theo nó.
# ĐÍNH CHÍNH 2026-09-08 (đo bằng curl, đừng chép lại INTEGRATION.md §5): nginx KHÔNG
# có route /ws/. `GET /ws/socket.io/?EIO=4&transport=polling` → 404; `GET /socket.io/?…`
# → 200, và POST `40/chat,` trên sid đó trả `error:auth {"error":"No token"}` — tức
# namespace /chat nằm ở path MẶC ĐỊNH /socket.io. Token WS = ProofChat accessToken
# (sau POST /auth/phoenixkey/login), KHÔNG phải session_token gốc PhoenixKey.
# ⚠ CỜ NÀY CHỈ NHẬN ĐÚNG CHUỖI `off` (proofchat-api.ts:112). `false` KHÔNG tắt gì cả —
# ai đọc dòng cũ rồi tưởng mình đã tắt module là hiểu ngược. Trống = để cổng runtime
# quyết theo /health; `off` = cưỡng bức mock.
PROOFCHAT_API_URL=https://api.proofchat.me/api/v1
# WS_URL KHÔNG kèm '/chat' — chatSocket.ts tự nối namespace /chat. (Kèm cũng không sao:
# code chuẩn hoá bỏ /chat cuối để tránh 'wss://.../chat/chat'.)
PROOFCHAT_WS_URL=wss://api.proofchat.me
PROOFCHAT_WS_PATH=/socket.io
PROOFCHAT_BACKEND_ENABLED=

# AladinWork (Việc-làm). Base ĐÃ gồm hậu tố /api/v1. Host prod đang SỐNG.
# Cổng runtime (config/runtimeGate.ts) tự bật khi /api/v1/health trả 2xx — KHÔNG
# cần đặt WORK_BACKEND_ENABLED=true. Kill-switch: đặt WORK_BACKEND_ENABLED=off để
# CƯỠNG BỨC mock (giữ 1 bản release luôn mock). Thiếu WORK_API_URL → không có host
# để probe → module ở empty-state (KHÔNG dựng dữ liệu mẫu).
WORK_API_URL=https://api.aladin.work/api/v1
# WORK_BACKEND_ENABLED=off   # bỏ trống = health tự quyết

# Analytics / thu thập hành vi người dùng (xem aladin_analytics_server)
ANALYTICS_API_URL=http://localhost:8080
ANALYTICS_API_KEY=dev-analytics-key

# Nhật ký từ xa (remoteLogger.ts + ScannerRemoteLog.swift). TRỐNG = TẮT hẳn phần đi
# mạng, rLog chỉ in ra console. Chỉ điền khi tự chạy log server để gỡ lỗi thực địa.
# ⛔ ĐỪNG điền tunnel ngrok vào bản phát hành: nhật ký gồm luồng nhận diện cây và
# `orilifeDidAuth`, tunnel tắt là ai giành tên miền cũng nhận được. Cổng
# `.github/workflows/android-aab.yml` nay chặn `ngrok-free.dev` trong bundle.
REMOTE_LOG_URL=

# Trợ lý Aladin (aladinChat.ts). TRỐNG = bong bóng trợ lý ẩn hẳn. Endpoint nhận
# NGUYÊN VĂN câu hỏi người dùng nên phải là host phát hành, không phải máy cá nhân.
ALADIN_CHAT_URL=

