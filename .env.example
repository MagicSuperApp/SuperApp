# ⚠️ COPY this file to .env and fill REAL values. .env is gitignored.
# Tùng PR #24 review 2026-05-18 — DO NOT commit .env to git.

# Firebase Configuration
# Get from: Firebase Console → Project Settings → General
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id_here
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Environment
ENV=development

# OriLife backend (Cloudflare Tunnel)
# Staging: https://staging-api.orilife.io  (Tiger:7390)
# Prod:    https://api.orilife.io (Tiger:7380, owned by Thắng Lợi)
ALADIN_API_URL=https://staging-api.orilife.io
ALADIN_API_KEY=mock-local-api-key
ALADIN_REGION_CODE=vn-south-01
PHOENIXKEY_API_URL=https://api.phoenixkey.me/api/v1
# Ví Phượng hoàng (ký tác-vụ did_payment). MẶC ĐỊNH false: backend Phase 2 CHƯA
# deploy → UI ẩn/disable nút ký. Đặt true SAU khi backend did_payment sẵn sàng
# VÀ đã đối-chiếu shape API ở src/services/phoenixWallet-api.ts. Bật cờ KHÔNG mở
# mainnet (mainnet chặn riêng ở ALLOWED_SIGN_NETWORKS).
PHOENIX_WALLET_ENABLED=false

# Ví tổ chức: tạo OrgDID + mint LAMP bằng OrgDID. MẶC ĐỊNH false vì mint CHƯA
# chạy thật — cap/authority/redeemer còn chờ LAMP hợp nhất design lên main, và
# phần dựng+ký CBOR chạy ở Enclave native (Thư) chưa ráp. Bật true SAU khi:
# (1) LAMP chốt cap/authority; (2) native cấp buildAndSignTx; (3) đối-chiếu shape
# API thật ở src/services/orgMint-api.ts. Khi false → UI xem được nhưng nút thao
# tác disabled, service ném OrgMintDisabledError trước khi gọi mạng.
ORG_MINT_ENABLED=false

MESHAPI_USE_MOCK=false
LAMPNET_BASE_URL=https://lampnet.cloud
LAMPNET_UPLOAD_URL=https://lampnet.cloud/mirage/put?mode=symmetric
CAPTURES_3D_URL=https://staging-api.orilife.io/captures/3d
# ⚠️ TẠM THỜI (giai đoạn test ReID quả/cây): trỏ về field-reid prototype test.orilife.io
#    vì các endpoint định-danh quả/cây (/api/fruit/*, /api/identify, /api/tree/*/layout...)
#    hiện CHỈ có trên prototype này. KHÔNG trỏ staging-api của Lợi — backend đó CHƯA có các route đó.
#    SAU KHI test xong sẽ HỢP-NHẤT về staging-api của Lợi (việc backend-unification PA3:
#    tạo cây 7390 trước → enroll field-reid cùng id → đẩy embedding ngược). Lúc đó đổi lại URL này.
ORILIFE_API_BASE_URL=https://test.orilife.io

# Tree Identity Native (TreeReID)
ORILIFE_TREEID_URL=https://test.orilife.io/TreeIdentity
ORILIFE_TREEID_BASE_URL=https://test.orilife.io


# Analytics / thu thập hành vi người dùng (xem aladin_analytics_server)
ANALYTICS_API_URL=http://localhost:8080
ANALYTICS_API_KEY=dev-analytics-key
