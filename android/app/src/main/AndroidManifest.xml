<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Build 52 (2026-05-18): voice memo 30s tap-to-record (P1 feature, iOS NSMicrophoneUsageDescription parity) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- tools:replace — expo-file-system (kéo theo bởi expo-gl/expo-asset cho nền 3D)
         khai báo cùng quyền này với maxSdkVersion=32. GIỮ 29 của app (chặt hơn:
         từ Android 11 quyền này gần như vô hiệu, xin rộng thêm chỉ tổ vướng review
         kho ứng dụng) và ép ghi đè để manifest merger không gãy. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:replace="android:maxSdkVersion" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- KHÔNG xin READ_MEDIA_IMAGES. Chính sách Photo & Video Permissions của Google Play
         (bắt buộc từ 2025-05-28, app không tuân bị GỠ khỏi kho) chỉ cho phép quyền này khi
         truy cập TOÀN BỘ thư viện ảnh là chức năng lõi — app quản lý ảnh, thư viện ảnh.
         App này chỉ chọn từng ảnh một, và `react-native-image-picker` v8 đã đi qua Android
         Photo Picker (`PickVisualMedia`, xem `ImagePickerModuleImpl.java:29`) — cửa đó KHÔNG
         cần quyền nào cả. Xin quyền thừa ở đây là tự chuốc một lượt từ chối.
         Nếu một thư viện nào đó merge quyền này vào, chặn thẳng bằng tools:node="remove". -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Push FCM (Android 13+ cần xin quyền hiện thông báo) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Rung: báo "đã tới nơi" ở màn Dẫn đường, báo bắt đầu ghi âm ở nút ghi chú
         giọng nói. Là quyền THƯỜNG (không hỏi lúc chạy), nhưng thiếu khai ở đây
         thì `Vibration.vibrate` ném SecurityException và làm sập màn. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- KHÔNG xin quyền ID quảng cáo. Play Console ▸ Publishing ▸ Advertising ID không
         cho hoàn tất khai báo khi quyền này có trong gói, và câu trả lời của app là KHÔNG.

         Quyền vào gói do MERGE, không do app khai: cả ba quyền họ quảng cáo đến từ
         `com.google.android.gms:play-services-measurement-api`, thư viện đo lường đi kèm
         Firebase (xem `manifest-merger-blame-*-release-report.txt`). Manifest khai TAY ở
         trên không có quyền nào thuộc họ này.

         ⚠ Nhưng gỡ quyền KHÔNG PHẢI vì app không đụng tới đo lường — app CÓ:
         `build.gradle` khai `firebase-analytics-ktx` và `MainActivity.kt` khởi tạo
         `Firebase.analytics` thật lúc chạy. Mà Firebase Analytics MẶC ĐỊNH thu ID quảng
         cáo khi quyền có mặt. Nên nếu chỉ gỡ dòng này thì câu trả lời "KHÔNG" đúng, song
         nó đúng vì một sự vắng mặt — không có gì trong kho nói ra ý định, và lần sau ai
         nâng Firebase hay thêm một thư viện kéo quyền về thì việc thu ID lặng lẽ bật lại.
         Vì vậy cờ `google_analytics_adid_collection_enabled` ở dưới KHAI Ý ĐỊNH, còn dòng
         này CƯỠNG CHẾ nó. Giữ cả hai; bỏ một cái là để lại đúng chỗ hỏng không tự kêu.

         Hai quyền `ACCESS_ADSERVICES_*` cùng thư viện thì KHÔNG đụng: màn hình Play chỉ
         hỏi về `AD_ID`, và gỡ thêm thứ không ai đòi là mở rộng một đợt vá bằng suy đoán.

         Kiểm sau khi dựng — rỗng là đạt, còn ra dòng nào là `tools:node` chưa ăn:
           unzip -p <gói>.aab base/manifest/AndroidManifest.xml | strings | grep -i ad_id -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-feature android:name="android.hardware.location.gps" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:largeHeap="true"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">

      <property
        android:name="android.app.16kb_page_size"
        android:value="true" />

      <!-- Firebase Analytics: KHÔNG thu ID quảng cáo. Đây là vế KHAI Ý ĐỊNH của cặp đôi
           mô tả ở khối quyền `AD_ID` bên trên — vế cưỡng chế là `tools:node="remove"`.
           Cờ này một mình không đủ (một thư viện khác vẫn merge quyền vào gói và Play
           vẫn chặn); dòng gỡ quyền một mình cũng không đủ (nó không nói vì sao, nên
           người sau gỡ nó ra mà không biết mình vừa bật lại một thứ đã khai là KHÔNG). -->
      <meta-data
        android:name="google_analytics_adid_collection_enabled"
        android:value="false" />

      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTop"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!--
        MỘT activity, và đó là chủ ý — đừng thêm activity thứ hai để mở một màn React.

        Ở đây từng có `.FarmDetailActivity`: một Activity nạp ROOT REACT THỨ HAI qua
        `ReactRootView` riêng. Root đó dựng `Stack.Navigator` của chính nó và KHÔNG đi qua
        `AuthGate` như navigator chính — tức nó là lối vào app không có cổng phiên. Nó cũng
        không có nơi gọi nào: `startActivity` = 0 tệp trên toàn `android/**`.

        Vòng vá trước hạ nó xuống `exported="false"`. Đóng cửa ngoài chặn được app khác trên
        cùng máy gọi vào, nhưng KHÔNG chạm cái gốc: root React thứ hai vẫn còn, vẫn nằm ngoài
        `AuthGate`, và vẫn nằm ngoài lưới chống-trắng-màn ở `index.js`. Cửa đóng thì không ai
        đi qua được, nhưng nó vẫn là một cửa, và cửa nào cũng có ngày ai đó mở lại.

        Màn `FarmDetail` KHÔNG mất: nó là một route bình thường của navigator chính
        (`src/navigation/registry.ts`), và mọi nơi gọi đều đi bằng `navigate('FarmDetail')`.
        Ngày cần mở nó từ mã native: gửi một sự kiện vào root đang chạy, đừng dựng root mới.
      -->
    </application>
    
</manifest>
