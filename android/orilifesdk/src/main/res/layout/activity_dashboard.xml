<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".DashboardActivity">

    <!-- Background Pattern -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/bg_button_gradient"
        android:alpha="0.05"
        android:rotation="45"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:translationX="100dp"
        android:translationY="-100dp" />

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/horizontal_margin"
        android:paddingTop="@dimen/top_safe_margin"
        android:paddingBottom="@dimen/card_padding_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OriLife"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/app_primary"
            android:textSize="48sp"
            android:letterSpacing="-0.02" />

        <TextView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:text="Cây đã lưu"
             android:textColor="@color/text_primary"
             android:textSize="18sp"
             android:fontFamily="sans-serif-medium"
             android:layout_marginTop="24dp"/>

    </LinearLayout>

    <!-- Offline Warning Banner -->
    <LinearLayout
        android:id="@+id/offlineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF3E0"
        android:padding="12dp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar">
        
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_wifi_off"
            app:tint="#E65100" />
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Không có kết nối mạng. Video sẽ được tải lên khi có mạng."
            android:textColor="#E65100"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Upload Progress Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardUploadProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/offlineBanner">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cloud_upload"
                    app:tint="@color/app_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang đồng bộ"
                    android:textColor="@color/app_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
            
            <TextView
                android:id="@+id/tvUploadStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Đang tải lên 1/3 video..."
                android:textSize="14sp"
                android:textColor="@color/text_primary" />
            
            <ProgressBar
                android:id="@+id/progressUpload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:progress="33"
                android:max="100" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Saved Trees List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecentHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/horizontal_margin"
        android:paddingBottom="@dimen/list_bottom_padding"
        app:layout_constraintTop_toBottomOf="@id/cardUploadProgress"
        app:layout_constraintBottom_toBottomOf="parent" />
    
    <!-- Empty State Text -->
     <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvRecentHistory"
        app:layout_constraintBottom_toBottomOf="@id/rvRecentHistory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_tree"
            android:alpha="0.3"
            app:tint="#999999" />
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Chưa có cây nào được lưu"
            android:textColor="#999999"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Quét cây và lưu để xem tại đây"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />
        
    </LinearLayout>

    <!-- Scan Button (Bottom Pill) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardScan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="100dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_primary"
            android:paddingHorizontal="32dp"
            android:paddingVertical="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_scan_focus" 
                    app:tint="@color/app_background"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ấn để quét"
                    android:textColor="@color/app_background"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
