<?xml version="1.0" encoding="UTF-8"?>
<!-- Nguồn LaunchScreen của app Aladin — bản y hệt `ios/SuperApp/LaunchScreen.storyboard`
     hôm 2026-09-10, giữ lại đây làm "instances/<mã>/ios/" cho Aladin, đối xứng với
     `instances/checkfarm/ios/LaunchScreen.storyboard`. Chưa có bước dựng nào copy tệp
     này đè lên `ios/SuperApp/LaunchScreen.storyboard` (xem chú thích ở đầu tệp đó) —
     tệp này hiện chỉ là NGUỒN sẵn sàng, đúng bằng đường lùi hôm nay nên Aladin không
     đổi hành vi khi bước copy được nối dây. -->
