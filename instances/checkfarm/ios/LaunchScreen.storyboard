<?xml version="1.0" encoding="UTF-8"?>
<!-- Nguồn LaunchScreen của app CheckFarm — tên + khẩu hiệu + màu nền riêng, KHÔNG
     mượn của Aladin. Ba giá trị chép có nhãn từ nguồn CheckFarm đã khai:
       - text "CheckFarm"            ← instances/checkfarm/instance.json:3 (displayName)
       - khẩu hiệu tiếng Anh          ← src/config/instance.config.ts CHECKFARM_INSTANCE.tagline.en
                                         ("Trace the Source — Elevate the Produce"), chép 2026-09-10
       - màu nền #298A4A → (0.161, 0.541, 0.290) ← instances/checkfarm/instance.json:23 (android.iconBackground)
     CHƯA có bước dựng nào copy tệp này đè lên `ios/SuperApp/LaunchScreen.storyboard`
     (xem chú thích ở đầu tệp đó — cần một bước kiểu "Soát danh tính app iOS" /
     copy AppIcon.appiconset trong `codemagic.yaml`, ngoài phạm vi sở hữu tệp của
     đợt dọn này). Tới khi bước đó được nối dây, app CheckFarm dựng ra vẫn hiện màn
     chào của Aladin — đây là NGUỒN sẵn sàng, chưa phải bản đang chạy. -->
