# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Explicit CDN source — bắt buộc để CocoaPods tìm TensorFlowLiteSwift 2.17.0
source 'https://cdn.cocoapods.org/'

platform :ios, min_ios_version_supported
prepare_react_native_project!

# @react-native-firebase: BẮT BUỘC dưới use_frameworks! :static.
# Sửa lỗi build "declaration of 'RCTPromiseRejectBlock' must be imported from
# module 'RNFBApp.RNFBAppModule' before it is required" (RNFBMessaging+AppDelegate.h).
# Biến GLOBAL phải set TRƯỚC use_native_modules!/use_react_native! để RNFB podspec
# đọc được lúc resolve (build các RNFB pod thành static framework, module map đúng).
$RNFirebaseAsStaticFramework = true

# Force static linkage for all Pods to support Firebase Swift dependencies
# This correctly solves the "Swift pods cannot yet be integrated as static libraries" error
# without triggering the messy Clang module errors caused by global use_modular_headers!
linkage = ENV['USE_FRAMEWORKS'] || 'static'

if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'aladin_mobile_fe' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # TensorFlowLiteSwift and SQLite.swift are already declared as dependencies
  # inside ScannerModule.podspec — do NOT duplicate here to avoid
  # "linked library 'sqlite3' not found" when USE_FRAMEWORKS=static.

  # PhoenixKey Rust core (Master_KEK / BIP39). .a + header sinh trên CI bởi
  # rust/taad_enclave_core/build_ios.sh TRƯỚC pod install (xem codemagic.yaml).
  pod 'taad_enclave_core', :path => '../rust/taad_enclave_core/ios'

  # ProofChat E2EE Rust core (chat_mls). .a + header sinh trên CI bởi
  # rust/chat_mls/build_ios.sh TRƯỚC pod install (xem codemagic.yaml).
  pod 'chat_mls', :path => '../rust/chat_mls/ios'

  # Local ScannerModule — full native iOS scanner SDK
  pod 'ScannerModule', :path => './LocalPods/ScannerModule'

  # Firebase Analytics
  pod 'Firebase/Analytics'

  post_install do |installer|
    # WORKAROUND: Create missing ReactAppDependencyProvider.h
    # This file is required by Pods but not generated by React Native codegen
    codegen_dir = "#{Pod::Config.instance.installation_root}/build/generated/ios/ReactAppDependencyProvider"
    FileUtils.mkdir_p(codegen_dir)
    File.write("#{codegen_dir}/RCTAppDependencyProvider.h", <<~HEADER)
      #import <Foundation/Foundation.h>
      @interface RCTAppDependencyProvider : NSObject
      @end
    HEADER
    Pod::UI.puts "✅ Created RCTAppDependencyProvider.h workaround".green

    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Link MapLibre Native SDK (bắt buộc cho maplibre-react-native v10+)
    if defined?($MLRN)
      Pod::UI.puts "Configuring SPM SDK for MapLibre".green
      $MLRN.post_install(installer)
    end

    # Fix: Nâng deployment target cho các pods vẫn dùng iOS 9.0/11.0
    # Tránh warning "deployment target is set to 9.0 but range is 12.0 to X"
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.to_f < 13.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
        end

        # Fix Xcode 16 ScanDependencies / Module errors for static React Native Pods
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

        # Fix cho Xcode 16 / clang ScanDependencies crash trên maplibre Obj-C++ headers
        # Nguyên nhân: static framework + Obj-C++ mixed source + module validation
        # HÀNG PHÒNG THỦ: CLANG_SCAN_DEPS_ENABLE bên xcodebuild command trong
        # codemagic.yaml sẽ disable toàn bộ scan phase ở mức CLI (override xcconfig).
        if target.name == 'maplibre-react-native'
          config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
          config.build_settings['CLANG_SCAN_DEPS_ENABLE'] = 'NO'
          # Disable signature aggregation for unsigned builds — prevents
          # "MapLibre.xcframework-ios.signature couldn't be copied to Signatures"
          # error when Xcode tries to deduplicate .signature files across targets.
          config.build_settings['ENABLE_SIGNATURE_AGGREGATION'] = 'NO'
        end

        # Disable CLANG Module Validation globally để tránh cached lỗi trên CI
        config.build_settings['CLANG_MODULES_VALIDATE_SYSTEM_HEADERS'] = 'NO'

        # @react-native-firebase/messaging: TẮT clang modules riêng cho target này.
        # Lỗi build "declaration of 'RCTPromiseRejectBlock' must be imported from
        # module 'RNFBApp.RNFBAppModule' before it is required":
        #   RNFBApp build thành clang module đã "nuốt" các type React (RCTPromiseRejectBlock,
        #   RCTConvert) vào module của nó. Khi RNFBMessaging `@import RNFBApp` rồi lại dùng
        #   type đó qua textual `#import <React/..>` trong header → clang xung đột.
        # Tắt modules cho RNFBMessaging → mọi import thành textual đồng nhất, hết xung đột.
        # RNFBMessaging thuần ObjC (0 file Swift) nên tắt modules an toàn.
        # $RNFirebaseAsStaticFramework=true ở đầu Podfile là điều kiện cần nhưng chưa đủ
        # cho RN 0.84 New Arch — cần thêm bước này.
        if target.name == 'RNFBMessaging'
          config.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
        end
      end
    end

    # ── Firebase iOS notes ──────────────────────────────────────────────
    # @react-native-firebase/app autolink tự tạo script phase
    # "[CP] Copy Pods Resources" copy GoogleService-Info.plist và firebase.json
    # từ ios/ vào app bundle → KHÔNG cần thêm thủ công vào resources_build_phase.
    # Chỉ cần đảm bảo 2 file tồn tại trong ios/ (codemagic.yaml đã copy sẵn).
    # Nếu gặp "Multiple commands produce" → xóa block này và chạy pod install lại.
  end
end
