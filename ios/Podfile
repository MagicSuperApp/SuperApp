require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Explicit CDN source — bắt buộc để CocoaPods tìm TensorFlowLiteSwift 2.17.0
source 'https://cdn.cocoapods.org/'

# iOS 16.4: expo@56 (expo/expo-modules-core podspec) khai `:ios => '16.4'` — SDK 56
# bản này ĐÒI 16.4 (không phải 15.1 như trước tưởng). Podfile PHẢI khai 16.4 để khớp
# Xcode project (IPHONEOS_DEPLOYMENT_TARGET đã = 16.4) — nếu để min_ios_version_supported
# (=15.1 của RN 0.84), CocoaPods coi app target 15.1 → từ chối link Expo ("requires iOS
# 16.4 but app targets 15.1") → pod install fail. Đánh đổi: bỏ hỗ trợ iOS 15.x (bắt buộc
# nếu còn dùng expo 56 cho expo-gl 3D).
platform :ios, '16.4'
prepare_react_native_project!

# @react-native-firebase: BẮT BUỘC dưới use_frameworks! :static.
# Sửa lỗi build "declaration of 'RCTPromiseRejectBlock' must be imported from
# module 'RNFBApp.RNFBAppModule' before it is required" (RNFBMessaging+AppDelegate.h).
# Biến GLOBAL phải set TRƯỚC use_native_modules!/use_react_native! để RNFB podspec
# đọc được lúc resolve (build các RNFB pod thành static framework, module map đúng).
$RNFirebaseAsStaticFramework = true

# Force static linkage for all Pods to support Firebase Swift dependencies
# This correctly solves the "Swift pods cannot yet be integrated as static libraries" error
# without triggering the messy Clang module errors caused by global use_modular_headers!
linkage = ENV['USE_FRAMEWORKS'] || 'static'

if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'aladin_mobile_fe' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # TensorFlowLiteSwift and SQLite.swift are already declared as dependencies
  # inside ScannerModule.podspec — do NOT duplicate here to avoid
  # "linked library 'sqlite3' not found" when USE_FRAMEWORKS=static.

  # PhoenixKey Rust core (Master_KEK / BIP39). .a + header sinh trên CI bởi
  # rust/taad_enclave_core/build_ios.sh TRƯỚC pod install (xem codemagic.yaml).
  pod 'taad_enclave_core', :path => '../rust/taad_enclave_core/ios'

  # ProofChat E2EE Rust core (chat_mls). .a + header sinh trên CI bởi
  # rust/chat_mls/build_ios.sh TRƯỚC pod install (xem codemagic.yaml).
  pod 'chat_mls', :path => '../rust/chat_mls/ios'

  # Local ScannerModule — full native iOS scanner SDK
  pod 'ScannerModule', :path => './LocalPods/ScannerModule'

  # Firebase Analytics
  pod 'Firebase/Analytics'

  post_install do |installer|
    # WORKAROUND: Create missing ReactAppDependencyProvider.h
    # This file is required by Pods but not generated by React Native codegen
    codegen_dir = "#{Pod::Config.instance.installation_root}/build/generated/ios/ReactAppDependencyProvider"
    FileUtils.mkdir_p(codegen_dir)
    File.write("#{codegen_dir}/RCTAppDependencyProvider.h", <<~HEADER)
      #import <Foundation/Foundation.h>
      @interface RCTAppDependencyProvider : NSObject
      @end
    HEADER
    Pod::UI.puts "✅ Created RCTAppDependencyProvider.h workaround".green

    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Link MapLibre Native SDK (bắt buộc cho maplibre-react-native v10+)
    if defined?($MLRN)
      Pod::UI.puts "Configuring SPM SDK for MapLibre".green
      $MLRN.post_install(installer)
    end

    # Fix: Nâng deployment target cho các pods vẫn dùng iOS 9.0/11.0
    # Tránh warning "deployment target is set to 9.0 but range is 12.0 to X"
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.to_f < 13.0
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
        end

        # Fix Xcode 16 ScanDependencies / Module errors for static React Native Pods
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

        # Fix cho Xcode 16 / clang ScanDependencies crash trên maplibre Obj-C++ headers
        # Nguyên nhân: static framework + Obj-C++ mixed source + module validation
        # HÀNG PHÒNG THỦ: CLANG_SCAN_DEPS_ENABLE bên xcodebuild command trong
        # codemagic.yaml sẽ disable toàn bộ scan phase ở mức CLI (override xcconfig).
        if target.name == 'maplibre-react-native'
          config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
          config.build_settings['CLANG_SCAN_DEPS_ENABLE'] = 'NO'
          # Disable signature aggregation for unsigned builds — prevents
          # "MapLibre.xcframework-ios.signature couldn't be copied to Signatures"
          # error when Xcode tries to deduplicate .signature files across targets.
          config.build_settings['ENABLE_SIGNATURE_AGGREGATION'] = 'NO'
        end

        # Disable CLANG Module Validation globally để tránh cached lỗi trên CI
        config.build_settings['CLANG_MODULES_VALIDATE_SYSTEM_HEADERS'] = 'NO'

        # @react-native-firebase/messaging: TẮT clang modules riêng cho target này.
        # Lỗi build "declaration of 'RCTPromiseRejectBlock' must be imported from
        # module 'RNFBApp.RNFBAppModule' before it is required":
        #   RNFBApp build thành clang module đã "nuốt" các type React (RCTPromiseRejectBlock,
        #   RCTConvert) vào module của nó. Khi RNFBMessaging `@import RNFBApp` rồi lại dùng
        #   type đó qua textual `#import <React/..>` trong header → clang xung đột.
        # Tắt modules cho RNFBMessaging → mọi import thành textual đồng nhất, hết xung đột.
        # RNFBMessaging thuần ObjC (0 file Swift) nên tắt modules an toàn.
        # $RNFirebaseAsStaticFramework=true ở đầu Podfile là điều kiện cần nhưng chưa đủ
        # cho RN 0.84 New Arch — cần thêm bước này.
        if target.name == 'RNFBMessaging'
          config.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
        end

        # ── FIX: ExpoModulesJSI + Xcode 26 / Swift 6 breaking change ──────────
        # Triệu chứng: Xcode 26 build ExpoModulesJSI xcframework với -swift-version 6
        # → tất cả `weak let` bị lỗi: "'weak' must be a mutable variable, because it
        # may change at runtime" (Swift 6 không cho phép weak let, phải dùng weak var).
        # expo@56.0.x bundled expo-modules-jsi chưa update cho Swift 6.
        # Fix: ép Swift 5.9 cho pod này → tương thích ngược, build pass.
        if target.name == 'ExpoModulesJSI'
          config.build_settings['SWIFT_VERSION'] = '5.9'
        end

        # ── FIX: expose module `React_RCTAppDelegate` cho APP target ──────────
        # Triệu chứng: dưới use_frameworks! :static + expo (SDK 56), pod
        # React-RCTAppDelegate BUILD ĐƯỢC nhưng KHÔNG vend clang module →
        # AppDelegate.swift `import React_RCTAppDelegate` báo "no such module"
        # (Expo/RCTAppDelegateUmbrella.h dùng __has_include nên tự bỏ qua =
        #  bằng chứng framework/header của pod này KHÔNG nằm trên search path).
        # Ép sinh module map + bật clang modules cho chính pod này để framework
        # xuất `React_RCTAppDelegate.framework` có module importable.
        if target.name == 'React-RCTAppDelegate'
          config.build_settings['DEFINES_MODULE'] = 'YES'
          config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        end
      end
    end

    # ── Firebase iOS notes ──────────────────────────────────────────────
    # @react-native-firebase/app autolink tự tạo script phase
    # "[CP] Copy Pods Resources" copy GoogleService-Info.plist và firebase.json
    # từ ios/ vào app bundle → KHÔNG cần thêm thủ công vào resources_build_phase.
    # Chỉ cần đảm bảo 2 file tồn tại trong ios/ (codemagic.yaml đã copy sẵn).
    # Nếu gặp "Multiple commands produce" → xóa block này và chạy pod install lại.

    # ── Guard: gỡ cầu nối expo↔worklets (ExpoModulesWorklets*) ────────────
    # expo-modules-core 56 kèm bridge tùy chọn ExpoModulesWorklets/Adapter, cần
    # react-native-worklets có header `worklets/Compat/StableApi.h` — bản 0.7.4 dự án
    # đang dùng CHƯA có → compile bridge gãy (giống lỗi Android đã tắt bằng
    # expo.enableWorkletsIntegration=false). App KHÔNG chạy expo module trên worklet
    # runtime (chỉ dùng expo-gl/asset) → gỡ an toàn.
    # No-op nếu CI/pod install KHÔNG kéo bridge vào (target không tồn tại).
    installer.pods_project.targets.each do |t|
      if t.name.start_with?('ExpoModulesWorklets')
        Pod::UI.puts "🩹 Excluding worklets bridge target: #{t.name}".yellow
        t.build_configurations.each do |c|
          c.build_settings['EXCLUDED_SOURCE_FILE_NAMES'] = '*'
        end
      end
    end

    # ── FIX (expo/expo #44475): `no such module 'React_RCTAppDelegate'` khi archive ──
    # Với use_frameworks! :static + prebuilt React, expo-modules-autolinking lúc pod
    # install PATCH modulemap trong React.xcframework: bỏ `framework module React`
    # (để không đụng non-framework `module React` ở Target Support Files) NHƯNG GIỮ
    # `framework module React_RCTAppDelegate`. Vấn đề: script RN "[RNDeps] Replace
    # React Native Core" (target React-Core-prebuilt) chạy lúc BUILD, `rmSync` + giải
    # nén LẠI React.xcframework khi đổi Debug↔Release → HOÀN NGUYÊN modulemap gốc →
    # `framework module React` quay lại, xung đột `module React` → cả modulemap parse
    # lỗi → `import React_RCTAppDelegate` báo "no such module" → archive fail.
    # Cách xử lý (Option A của issue): thêm build phase CUỐI cho React-Core-prebuilt,
    # chạy SAU script replace, re-patch bỏ `framework module React` mỗi lần build.
    rncore_prebuilt = installer.pods_project.targets.find { |t| t.name == 'React-Core-prebuilt' }
    if rncore_prebuilt
      phase_name = '[Expo-fix] Re-patch React modulemap (post RNDeps replace)'
      unless rncore_prebuilt.build_phases.any? { |p| p.respond_to?(:name) && p.name == phase_name }
        phase = rncore_prebuilt.new_shell_script_build_phase(phase_name)
        phase.shell_script = <<~'SH'
          # (1) Re-áp patch expo (bỏ `framework module React` để không đụng non-framework
          #     `module React`) + (2) KHAI THẲNG `module React_RCTAppDelegate` vào
          #     React-use-frameworks.modulemap — file SỐNG SÓT wipe + đã nằm trên search
          #     path của app (qua -fmodule-map-file). Đây mới là mấu chốt: import React
          #     chạy được vì có `module React` ở file này, còn React_RCTAppDelegate KHÔNG
          #     được khai ở đâu app tìm thấy → thêm nó vào ngay đây (trỏ umbrella header
          #     trong xcframework, giống hệt cách React_Core được khai).
          RUBY_BIN="$(command -v ruby || echo /usr/bin/ruby)"
          "$RUBY_BIN" -e '
            root = ENV["PODS_ROOT"]
            rx = /framework module React \{.*?\n\}\s*/m
            paths = Dir.glob("#{root}/React-Core-prebuilt/React.xcframework/*/React.framework/Modules/module.modulemap")
            shared = "#{root}/React-Core-prebuilt/React.xcframework/Modules/module.modulemap"
            paths << shared if File.exist?(shared)
            paths.each do |f|
              c = File.read(f)
              next unless c =~ rx
              c.gsub!(rx, "")
              File.write(f, c)
              puts "[Expo-fix] re-patched framework modulemap: #{f}"
            end
            mm = "#{root}/Target Support Files/React-Core-prebuilt/React-use-frameworks.modulemap"
            umb = "#{root}/React-Core-prebuilt/React.xcframework/Headers/React_RCTAppDelegate/React_RCTAppDelegate-umbrella.h"
            if File.exist?(mm) && File.exist?(umb)
              content = File.read(mm)
              unless content.include?("module React_RCTAppDelegate")
                File.write(mm, content + "\nmodule React_RCTAppDelegate {\n  umbrella header \"#{umb}\"\n  export *\n}\n")
                puts "[Expo-fix] added module React_RCTAppDelegate -> #{mm}"
              end
            else
              puts "[Expo-fix] WARN: missing modulemap or umbrella (mm=#{File.exist?(mm)} umb=#{File.exist?(umb)})"
            end
          '
        SH
        # Không dựa vào dependency-analysis: luôn chạy để bám theo mỗi lần replace wipe.
        phase.always_out_of_date = '1' if phase.respond_to?(:always_out_of_date=)
        Pod::UI.puts "✅ Added '#{phase_name}' to React-Core-prebuilt".green
      end
    end
  end
end
