<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1087679454079-vqsfa0ke9bhdurahb6q23vv0svdbsium</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- ATS: KHÔNG mở NSAllowsArbitraryLoads. Khoá đó tắt bảo vệ tầng vận chuyển cho TOÀN
	     BỘ app và là chỗ App Review hỏi đầu tiên — Apple yêu cầu lý do chính đáng, và
	     "cho tiện lúc phát triển" không phải lý do được nhận. App này không cần nó: mọi
	     base URL đều https (`.env.example:37,45,49`) và không còn URL http:// thật nào
	     trong `src/`. NSAllowsLocalNetworking đủ cho Metro chạy qua LAN lúc gỡ lỗi. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Ứng dụng cần sử dụng camera để định danh quả và chụp ảnh nông trại.</string>
	<!-- Tên app trong câu này lấy từ $(APP_DISPLAY_NAME) — CÙNG biến đang dùng cho
	     `CFBundleDisplayName` ở trên. Xcode thay thế $(...) bên trong MỌI giá trị
	     chuỗi của Info.plist lúc build (không riêng gì giá trị nguyên khối), nên
	     không cần thêm bước dựng nào: `codemagic.yaml` đã truyền biến này cho mọi
	     workflow ký (`APP_DISPLAY_NAME="$APP_DISPLAY_NAME"` ở lệnh `xcodebuild`),
	     và `project.pbxproj` đặt sẵn giá trị mặc định `Aladin` cho build cục bộ/
	     Xcode không qua CI. App Aladin do vậy hiện ĐÚNG câu cũ, không đổi. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>$(APP_DISPLAY_NAME) ghi âm môi trường xung quanh cây trong 30 giây để hệ thống học hỏi thêm về điều kiện chụp.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Ứng dụng sử dụng Face ID để đăng nhập nhanh và bảo mật tài khoản.</string>
	<!-- ĐÃ GỠ NSLocationAlwaysAndWhenInUseUsageDescription. Khai khoá đó là xin quyền vị trí
	     NỀN, mà app chỉ đọc vị trí lúc đang mở: `Geolocation.watchPosition` ở
	     `FarmDetailScreen.tsx:525` và `TreeIdentityScreen.tsx:252`, và UIBackgroundModes chỉ
	     có remote-notification. Xin "Always" mà không dùng thì iOS hiện hộp thoại nặng hơn
	     cho người dùng, còn App Review đòi giải trình một hành vi app không hề có. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Ứng dụng cần vị trí để ghi nhận ranh giới nông trại và gắn toạ độ GPS cho mỗi điểm đo.</string>
	<key>NSMotionUsageDescription</key>
	<string>Ứng dụng sử dụng cảm biến chuyển động để theo dõi hướng camera khi chụp vòng quanh cây.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Ứng dụng cần lưu ảnh chụp nông trại vào thư viện của bạn.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Ứng dụng cần truy cập thư viện ảnh để chọn ảnh nông trại.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<!-- Push FCM/APNs: nhận message data-only khi nền (PhoenixKey sign-request/activation) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>MaterialCommunityIcons.ttf</string>
		<string>MaterialIcons.ttf</string>
		<string>Ionicons.ttf</string>
		<string>FontAwesome.ttf</string>
		<string>Octicons.ttf</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
